# ============================================================
# Credenciales del panel de administración (/keystatic)
# ============================================================
# En producción es OBLIGATORIO definir ADMIN_PASSWORD.
# - Si no se define, en desarrollo se usan admin / admin (solo local).
# - Si no se define en producción, el panel queda deshabilitado por seguridad.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# ============================================================
# Modo GitHub de Keystatic (edición desde la web publicada)
# ============================================================
# Define el repositorio para activar el modo GitHub (formato: usuario/repositorio).
# Sin esta variable, el panel funciona en modo local (edita los archivos del proyecto).
# En producción esta variable debe quedar fija (se recomienda desactivar el modo local).

PUBLIC_KEYSTATIC_GITHUB_REPO=

# Las siguientes variables se generan automáticamente la primera vez que entras
# a /keystatic con el modo GitHub activo y completas el asistente "Create GitHub App".
# Después debes copiarlas al entorno de tu hosting (Render, Vercel, etc.):

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
