# ============================================================
# Credenciales del panel de administración (/keystatic)
# ============================================================
# En producción es OBLIGATORIO definir ADMIN_PASSWORD.
# - Si no se define, en desarrollo se usan admin / admin (solo local).
# - Si no se define en producción, el panel queda deshabilitado por seguridad.
# - Si la defines en .env.local, admin / admin deja de funcionar en local:
#   entra con el usuario y la contraseña escritos en ese archivo.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# ============================================================
# Modo GitHub de Keystatic (edición desde la web publicada)
# ============================================================
# Define el repositorio para activar el modo GitHub (formato: usuario/repositorio).
# Sin esta variable, el panel funciona en modo local (edita los archivos del proyecto).
# En producción esta variable debe quedar fija (se recomienda desactivar el modo local).

PUBLIC_KEYSTATIC_GITHUB_REPO=

# Las siguientes variables se generan automáticamente la primera vez que entras
# a /keystatic con el modo GitHub activo y completas el asistente "Create GitHub App".
# Después debes copiarlas al entorno de tu hosting (Render, Vercel, etc.):

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# ============================================================
# Formulario de contacto (entrega por Resend)
# ============================================================
# RESEND_API_KEY es la clave del servicio (Resend → API Keys).
# CONTACT_TO es el buzón que recibe las solicitudes; si no se define, el
# formulario escribe a contacto@hlserviciosprofesionales.com (valor por
# defecto en src/pages/api/contacto.ts).
# CONTACT_FROM es el remitente; su dominio debe estar verificado en Resend.

RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# ============================================================
# Mapa de /contacto (teselas CARTO)
# ============================================================
# Clave gratuita de CARTO Basemaps (carto.com/basemaps/apikey): 5M peticiones
# al mes en uso no comercial y 1M al mes en comercial. Es pública, viaja en el
# HTML y solo sirve para pedir teselas. Sin ella el mapa usa Esri Dark Gray
# Canvas, que no pide clave, así que la web nunca se queda sin calles.

PUBLIC_CARTO_KEY=

# ============================================================
# Analítica (Umami Cloud, sin cookies)
# ============================================================
# El ID público del sitio ya viene por defecto en src/scripts/analytics.ts.
# Define estas variables solo si necesitas cambiarlo sin tocar código
# (por ejemplo, al rotar la web en Umami o al autoalojar Umami).

PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_HOST=
# Envía eventos también desde localhost (por defecto en local no se envía nada).
PUBLIC_UMAMI_DEBUG=false
