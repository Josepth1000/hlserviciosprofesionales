---
import Layout from '../layouts/Layout.astro';
import LegalPage from '../components/LegalPage.astro';
import { getSiteData, getTextosData } from '../lib/content';

const site = await getSiteData();
const textos = await getTextosData();
const page = textos.legalNotice;
---

<Layout title={`${page.title} · ${site.name}`} description={page.subtitle}>
  <LegalPage page={page} />
</Layout>
