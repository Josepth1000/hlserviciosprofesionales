---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import { getCollection, render } from 'astro:content';
import { isPageSlugAllowed } from '../lib/pageSlugs';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages
    .filter((page) => page.data.status === 'publicada' && isPageSlugAllowed(page.id))
    .map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;

// En desarrollo los URLs no generados llegan aquí sin entrada → 404.
if (!page) {
  Astro.response.status = 404;
}

const { Content } = page ? await render(page) : { Content: undefined };
const d = page?.data;
const title = d?.seoTitle || d?.title || 'Página no encontrada';
const description = d?.seoDescription || d?.description || undefined;
---

<Layout title={title} description={description}>
  {page && d ? (
    <>
      <PageHero
        title={d.heroTitle || d.title}
        subtitle={d.heroSubtitle || undefined}
        image={d.heroImage || undefined}
      />

      <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="prose prose-slate max-w-none prose-headings:font-display prose-headings:text-ink-900 prose-p:leading-relaxed prose-blockquote:border-brand-500 prose-blockquote:bg-brand-50 prose-blockquote:not-italic prose-blockquote:px-5 prose-blockquote:py-1 prose-a:text-ink-700">
          {Content && <Content />}
        </div>
      </article>

      <CTABand />
    </>
  ) : (
    <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-28 text-center sm:px-6 lg:px-8">
      <p class="font-display text-6xl font-bold text-brand-500">404</p>
      <h1 class="mt-4 font-display text-3xl font-bold text-ink-900 sm:text-4xl">Página no encontrada</h1>
      <p class="mt-3 text-slate-600">La página que buscas no existe o fue movida.</p>
      <a href="/" class="mt-8 inline-flex items-center gap-2 rounded-md bg-brand-500 px-6 py-3 text-sm font-semibold text-ink-950 transition hover:bg-brand-400">
        Volver al inicio
      </a>
    </section>
  )}
</Layout>