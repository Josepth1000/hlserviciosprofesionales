---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PostCard from '../components/PostCard.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import { getSiteData, getServices, getServiceImageMap, getAfiliacionData, getTestimonials, getFaqs, getTextosData, getWhatsAppLink } from '../lib/content';
import { formatCOP } from '../lib/format';
import { getCollection } from 'astro:content';

const site = await getSiteData();
const textos = await getTextosData();
const services = await getServices();
const afiliacion = await getAfiliacionData();
const testimonials = await getTestimonials();
const faqs = await getFaqs();
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const serviceImageMap = getServiceImageMap(site);
const minSalud = Math.min(...afiliacion.plans.map((p) => p.salud));
const waLink = getWhatsAppLink(site.whatsapp, textos.global.whatsappMessage);
---

<Layout
  title="Inicio"
  description={site.description}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink-950">
    <img src={site.hero.image} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-30" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink-950 via-ink-950/85 to-ink-900/50"></div>
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.035]"
      style="background-image: radial-gradient(circle at 1px 1px, #fff 1px, transparent 0); background-size: 30px 30px"
      aria-hidden="true"
    ></div>
    <div class="animate-blob pointer-events-none absolute -right-32 -top-40 h-[28rem] w-[28rem] rounded-full bg-brand-600/25 blur-3xl"></div>
    <div class="animate-blob-slow pointer-events-none absolute -bottom-48 -left-32 h-96 w-96 rounded-full bg-brand-500/15 blur-3xl"></div>

    <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
      <div class="max-w-2xl">
        <p class="animate-rise inline-flex items-center gap-2 rounded-full border border-brand-500/40 bg-brand-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-brand-300">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span>
          {site.hero.badge}
        </p>
        <h1 class="animate-rise mt-6 font-display text-4xl font-bold leading-tight text-white sm:text-5xl lg:text-6xl" style="animation-delay: 90ms">
          {site.hero.titlePrefix} <span class="text-brand-400">{site.hero.highlight}</span> {site.hero.titleSuffix}
        </h1>
        <p class="animate-rise mt-6 max-w-xl text-lg leading-relaxed text-ink-100" style="animation-delay: 180ms">{site.hero.subtitle}</p>
        <div class="animate-rise mt-8 flex flex-wrap items-center gap-3" style="animation-delay: 270ms">
          <a
            href="/servicios"
            data-magnetic
            class="btn-shine inline-flex items-center gap-2 rounded-md bg-brand-500 px-6 py-3 text-sm font-semibold text-ink-950 transition hover:bg-brand-400"
          >
            {textos.home.heroPrimaryLabel}
            <Icon name="arrow" class="h-4 w-4" />
          </a>
          <a
            href={waLink}
            target="_blank"
            rel="noopener"
            data-magnetic
            class="inline-flex items-center gap-2 rounded-md border border-white/30 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
          >
            <Icon name="whatsapp" class="h-5 w-5" />
            {textos.home.heroSecondaryLabel}
          </a>
        </div>
      </div>
    </div>

    <!-- Banda de cifras -->
    <div class="relative border-t border-white/10 bg-ink-900/60 backdrop-blur">
      <div class="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-4 py-8 sm:px-6 lg:grid-cols-4 lg:px-8">
        {site.stats.map((stat, i) => (
          <div class="text-center" data-reveal style={`--reveal-delay: ${i * 130}ms`}>
            <p class="font-display text-3xl font-bold text-brand-400" data-counter>{stat.value}</p>
            <p class="mt-1 text-sm text-ink-100">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cinta marquee: nombres de los servicios deslizándose (datos del panel) -->
  <div class="marquee relative overflow-hidden border-y border-ink-800 bg-ink-900 py-4" aria-hidden="true">
    <div class="marquee-track flex w-max items-center">
      {[0, 1].map(() => (
        <div class="flex items-center gap-10 px-5 whitespace-nowrap">
          {services.map((s) => (
            <span class="flex items-center gap-10 text-sm font-semibold uppercase tracking-[0.22em] text-brand-300">
              {s.data.title}
              <span class="h-1.5 w-1.5 rotate-45 bg-brand-500/70"></span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- Servicios -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-600">{textos.home.services.label}</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-ink-900 sm:text-4xl">{textos.home.services.title}</h2>
      <p class="mt-4 text-slate-600">{textos.home.services.intro}</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service, i) => (
        <ServiceCard service={service} image={service.data.image ?? serviceImageMap.get(service.data.title)} featured={i === 2} delay={i * 110} />
      ))}
    </div>
  </section>

  <!-- Seguridad social destacado -->
  <section class="bg-brand-50">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div class="relative" data-reveal>
        <img
          src="/images/pensiones.jpg"
          alt="Afiliación a seguridad social"
          loading="lazy"
          class="w-full rounded-xl object-cover shadow-lg"
        />
        <div class="absolute -bottom-5 -right-5 hidden rounded-xl bg-brand-500 px-6 py-4 shadow-lg lg:block">
          <p class="font-display text-2xl font-bold text-ink-950">{textos.home.social.floatingTop}</p>
          <p class="text-sm font-medium text-ink-900">{textos.home.social.floatingBottom}</p>
        </div>
      </div>

      <div data-reveal style="--reveal-delay: 120ms">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-600">{textos.home.social.label}</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-ink-900 sm:text-4xl">
          {textos.home.social.title}
        </h2>
        <p class="mt-4 leading-relaxed text-slate-600">{textos.home.social.text}</p>
        <ul class="mt-6 space-y-3">
          {
            [`${textos.home.social.bulletPricePrefix} ${formatCOP(minSalud)}`, ...textos.home.social.bullets].map((item) => (
              <li class="flex items-start gap-3 text-slate-700">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700">
                  <Icon name="check" class="h-3.5 w-3.5" />
                </span>
                {item}
              </li>
            ))
          }
        </ul>
        <a
          href="/como-me-afilio"
          class="btn-shine mt-8 inline-flex items-center gap-2 rounded-md bg-ink-800 px-6 py-3 text-sm font-semibold text-white transition hover:bg-ink-700"
        >
          {textos.home.social.buttonLabel}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <Testimonials testimonials={testimonials} />

  <FAQ faqs={faqs} />

  <!-- Noticias -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end" data-reveal>
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-600">{textos.home.news.label}</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-ink-900 sm:text-4xl">{textos.home.news.title}</h2>
      </div>
      <a href="/noticias" class="inline-flex items-center gap-1.5 text-sm font-semibold text-ink-700 transition hover:gap-2.5 hover:text-brand-600">
        {textos.home.news.viewAll}
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {posts.map((post, i) => (
        <PostCard
          title={post.data.title}
          excerpt={post.data.description}
          pubDate={post.data.pubDate}
          category={post.data.category}
          slug={post.id}
          delay={i * 110}
        />
      ))}
    </div>
  </section>

  <CTABand />
</Layout>
