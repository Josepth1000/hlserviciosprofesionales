---
import '../../styles/global.css';
import PaletteStyle from '../../components/PaletteStyle.astro';
import { getSiteData } from '../../lib/content';

// Se renderiza a petición para leer ?error=1 y ?next= por cada solicitud
// (si fuera estática, el build no conocería los parámetros de la URL).
export const prerender = false;

const site = await getSiteData();
const next = Astro.url.searchParams.get('next') ?? '/keystatic';
const hasError = Astro.url.searchParams.get('error') === '1';
const reasonExpired = Astro.url.searchParams.get('reason') === 'expired';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B0B0D" />
    <title>Acceso al panel | HL Servicios Profesionales</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&family=Great+Vibes&display=swap"
      rel="stylesheet"
    />
    <PaletteStyle />
  </head>
  <body
    class="relative flex min-h-screen items-center justify-center overflow-x-clip overflow-y-hidden bg-ink-950 px-4 py-10 font-sans antialiased"
  >
    <!-- Ambiente: fondo oscuro con brillos dorados animados y patrón de puntos -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(1100px_500px_at_50%_-10%,rgba(201,162,39,0.14),transparent_60%)]"></div>
      <div class="animate-blob absolute -right-32 -top-40 h-[30rem] w-[30rem] rounded-full bg-brand-600/20 blur-3xl"></div>
      <div class="animate-blob-slow absolute -bottom-48 -left-32 h-96 w-96 rounded-full bg-brand-500/10 blur-3xl"></div>
      <div
        class="absolute inset-0 opacity-[0.035]"
        style="background-image: radial-gradient(circle at 1px 1px, #fff 1px, transparent 0); background-size: 28px 28px"
      ></div>
      <div class="absolute inset-0 bg-[radial-gradient(80%_60%_at_50%_50%,transparent_40%,rgba(0,0,0,0.55)_100%)]"></div>
    </div>

    <main class="relative w-full max-w-md">
      <div class="animate-rise relative overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-b from-ink-900 to-ink-950 shadow-2xl shadow-black/60">
        <!-- Línea dorada superior -->
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-500/80 to-transparent"></div>

        <div class="relative px-7 py-9 sm:px-10 sm:py-11">
          <!-- Marca: logo con halo y anillo dorados -->
          <div class="flex flex-col items-center text-center">
            <div class="relative flex h-24 w-24 items-center justify-center">
              <div class="absolute inset-0 rounded-full bg-brand-500/25 blur-2xl"></div>
              <div class="absolute inset-1 rounded-full border border-brand-500/25"></div>
              <img
                src={site.logo}
                alt={site.name}
                class="relative h-20 w-20 rounded-full ring-2 ring-brand-500/40"
                width="160"
                height="160"
              />
            </div>
            <p class="mt-5 font-script text-3xl leading-none text-gold-gradient">{site.brandName}</p>
            <p class="mt-2 text-[9px] font-semibold uppercase tracking-[0.3em] text-white/60">
              {site.slogan}
            </p>
            <h1 class="mt-6 font-display text-2xl font-bold text-white">Panel de administración</h1>
            <p class="mt-2 text-sm leading-relaxed text-ink-300">
              Inicia sesión para editar el contenido del sitio web.
            </p>

            <!-- Etiquetas de especialidad -->
            <div class="mt-5 flex flex-wrap items-center justify-center gap-1.5">
              <span class="rounded-full border border-brand-500/40 bg-brand-500/10 px-2.5 py-1 text-[11px] font-semibold text-brand-300">
                Seguridad social
              </span>
              <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-[11px] font-medium text-ink-200">
                Jurídico
              </span>
              <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-[11px] font-medium text-ink-200">
                Contable
              </span>
              <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-[11px] font-medium text-ink-200">
                Seguros
              </span>
            </div>
          </div>

          {
            hasError && (
              <div
                class="mt-7 flex items-start gap-2.5 rounded-lg border border-brand-500/40 bg-brand-500/10 px-4 py-3 text-sm text-brand-200"
                role="alert"
              >
                <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 8v4M12 16h.01" />
                </svg>
                Usuario o contraseña incorrectos. Inténtalo de nuevo.
              </div>
            )
          }

          {
            reasonExpired && (
              <div
                class="mt-7 flex items-start gap-2.5 rounded-lg border border-brand-500/40 bg-brand-500/10 px-4 py-3 text-sm text-brand-200"
                role="alert"
              >
                <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 8v4M12 16h.01" />
                </svg>
                Tu sesión se cerró por inactividad de 30 minutos. Inicia sesión nuevamente.
              </div>
            )
          }

          {
            import.meta.env.DEV && (
              <div class="mt-6 flex items-start gap-2.5 rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-ink-200">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                </svg>
                <span>
                  Modo desarrollo: usuario <strong class="text-white">admin</strong> / contraseña{" "}
                  <strong class="text-white">admin</strong>. Define{" "}
                  <code class="text-xs text-brand-300">ADMIN_PASSWORD</code> para cambiarlas.
                </span>
              </div>
            )
          }

          <form action="/api/login" method="POST" class="mt-7 space-y-4">
            <input type="hidden" name="next" value={next} />
            <div>
              <label for="username" class="mb-1.5 block text-sm font-medium text-ink-100">Usuario</label>
              <div class="relative">
                <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4.5 w-4.5 -translate-y-1/2 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                </svg>
                <input
                  id="username"
                  name="username"
                  type="text"
                  required
                  autocomplete="username"
                  class="w-full rounded-lg border border-white/15 bg-ink-950/70 py-2.5 pl-11 pr-4 text-sm text-white outline-none transition placeholder:text-ink-500 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/25"
                  placeholder="admin"
                />
              </div>
            </div>
            <div>
              <label for="password" class="mb-1.5 block text-sm font-medium text-ink-100">Contraseña</label>
              <div class="relative">
                <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4.5 w-4.5 -translate-y-1/2 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                </svg>
                <input
                  id="password"
                  name="password"
                  type="password"
                  required
                  autocomplete="current-password"
                  class="w-full rounded-lg border border-white/15 bg-ink-950/70 py-2.5 pl-11 pr-4 text-sm text-white outline-none transition placeholder:text-ink-500 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/25"
                  placeholder="••••••••"
                />
              </div>
            </div>
            <button
              type="submit"
              class="btn-shine w-full rounded-lg bg-gradient-to-b from-brand-400 to-brand-500 px-6 py-3 text-sm font-semibold text-ink-950 shadow-lg shadow-brand-900/40 transition hover:from-brand-300 hover:to-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-400/50"
            >
              Entrar al panel
            </button>
          </form>

          <div class="mt-7 flex items-center justify-center gap-3">
            <a
              href="/"
              class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-3.5 py-2 text-xs font-medium text-ink-200 transition hover:border-white/25 hover:text-white"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
              </svg>
              Volver al sitio
            </a>
            <a
              href="/api/logout"
              class="inline-flex items-center gap-1.5 rounded-lg border border-brand-500/40 bg-brand-500/10 px-3.5 py-2 text-xs font-semibold text-brand-300 transition hover:border-brand-500/70 hover:bg-brand-500/20"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
              </svg>
              Cerrar sesión
            </a>
          </div>
        </div>
      </div>

      <p class="mt-6 text-center text-xs text-ink-500">
        © {new Date().getFullYear()} HL Servicios Profesionales · Bucaramanga, Colombia
      </p>
    </main>
  </body>
</html>
