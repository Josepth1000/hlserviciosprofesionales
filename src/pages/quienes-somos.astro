---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';
import { getSiteData, getTextosData } from '../lib/content';

const site = await getSiteData();
const textos = await getTextosData();
const values = site.values;
---

<Layout
  title={textos.about.seoTitle}
  description={textos.about.seoDescription}
>
  <PageHero
    title={textos.about.hero.title}
    subtitle={textos.about.hero.subtitle}
    image={textos.about.hero.image}
  />

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div data-reveal>
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-600">{textos.about.label}</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-ink-900 sm:text-4xl">
          {textos.about.title}
        </h2>
        <p class="mt-5 leading-relaxed text-slate-600">{textos.about.paragraph1}</p>
        <p class="mt-4 leading-relaxed text-slate-600">{textos.about.paragraph2}</p>

        <dl class="mt-8 space-y-4">
          <div class="flex gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-ink-800 text-brand-400">
              <Icon name="pin" class="h-5 w-5" />
            </span>
            <div>
              <dt class="font-semibold text-ink-900">{textos.about.locationLabel}</dt>
              <dd class="text-sm text-slate-600">{site.address}</dd>
            </div>
          </div>
        </dl>
      </div>

      <figure data-reveal style="--reveal-delay: 140ms">
        <img
          src={textos.about.founder.image}
          alt={textos.about.founder.name}
          loading="lazy"
          class="w-full rounded-xl object-cover shadow-lg"
        />
        <figcaption class="mt-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="font-display text-lg font-semibold text-ink-900">{textos.about.founder.name}</p>
          <p class="text-sm text-slate-600">{textos.about.founder.role}</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{textos.about.founder.bio}</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-ink-950">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-400">{textos.about.values.label}</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl">{textos.about.values.title}</h2>
        <p class="mt-4 text-ink-100">{textos.about.values.intro}</p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((value, i) => (
          <div
            class="rounded-xl border border-ink-800 bg-ink-900 p-6 transition duration-300 hover:-translate-y-1 hover:border-brand-500/40 hover:shadow-xl"
            data-reveal
            data-spotlight
            style={`--reveal-delay: ${i * 110}ms`}
          >
            <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-brand-500 text-ink-950">
              <Icon name={value.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-4 font-display text-lg font-semibold text-white">{value.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-100">{value.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABand />
</Layout>
