---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import CTABand from '../../components/CTABand.astro';
import { getCollection } from 'astro:content';
import { getTextosData } from '../../lib/content';

// Archivo completo de publicaciones en /blog. Los artículos viven en
// /blog/<slug>, así que esta ruta evita que una URL truncada acabe en 404.
// No es un listado nuevo: repite lo que ya muestra /noticias, por eso consolida
// su canónica allí (canonicalPath) y queda fuera del sitemap.
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const textos = await getTextosData();
---

<Layout
  title={textos.news.seoTitle}
  description={textos.news.seoDescription}
  canonicalPath="/noticias"
>
  <PageHero
    title={textos.news.hero.title}
    subtitle={textos.news.hero.subtitle}
    image={textos.news.hero.image}
  />

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    {posts.length === 0 ? (
      <p class="text-center text-slate-600">{textos.news.empty}</p>
    ) : (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, i) => (
          <PostCard
            title={post.data.title}
            excerpt={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            slug={post.id}
            headingLevel={2}
            delay={i * 100}
          />
        ))}
      </div>
    )}
  </section>

  <CTABand />
</Layout>
