---
import { iconLoaders } from '../lib/animated-icons';
import { iconMarkup } from '../lib/icon-markup';

interface Props {
  name: string;
  class?: string;
}
const { name, class: className = 'h-6 w-6' } = Astro.props;

// Los dos iconos que se quedan con el trazo estático: la balanza no existe en
// las colecciones del paquete y la estrella de las calificaciones se lee mejor
// rellena que en contorno.
const staticIcons: Record<string, { d: string; filled?: boolean }> = {
  scale: {
    d: 'M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0 0 12 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 0 1-2.031.352 5.988 5.988 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971Zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 0 1-2.031.352 5.989 5.989 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.971Z',
  },
  star: {
    d: 'M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z',
    filled: true,
  },
};

const loader = iconLoaders[name];
const data = loader ? await loader() : undefined;
const fallback = staticIcons[name];

if (!data && !fallback) {
  throw new Error(`Icono desconocido: ${name}`);
}
---

{
  data ? (
    <Fragment set:html={iconMarkup(data, { name, className })} />
  ) : (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill={fallback?.filled ? 'currentColor' : 'none'}
      stroke={fallback?.filled ? undefined : 'currentColor'}
      stroke-width={fallback?.filled ? undefined : '1.5'}
      stroke-linecap={fallback?.filled ? undefined : 'round'}
      stroke-linejoin={fallback?.filled ? undefined : 'round'}
      aria-hidden="true"
    >
      <path d={fallback?.d} />
    </svg>
  )
}
