---
import { getTextosData } from '../lib/content';

interface Props {
  title: string;
  subtitle?: string;
  image?: string;
}

const { title, subtitle, image = '/images/hero/image.jpg' } = Astro.props;
const textos = await getTextosData();
---

<section class="relative overflow-hidden bg-ink-950">
  <img src={image} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-25" />
  <div class="absolute inset-0 bg-gradient-to-r from-ink-950 via-ink-950/80 to-ink-900/40"></div>
  <div class="animate-blob pointer-events-none absolute -right-32 -top-40 h-[26rem] w-[26rem] rounded-full bg-brand-600/20 blur-3xl"></div>
  <div class="animate-blob-slow pointer-events-none absolute -bottom-48 -left-32 h-96 w-96 rounded-full bg-brand-500/15 blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
    <p class="animate-rise text-xs font-semibold uppercase tracking-widest text-brand-400">
      {textos.global.pageHeroLabel}
    </p>
    <h1 class="animate-rise mt-3 max-w-3xl font-display text-4xl font-bold text-white sm:text-5xl" style="animation-delay: 80ms">
      {title}
    </h1>
    {subtitle && (
      <p class="animate-rise mt-4 max-w-2xl text-lg leading-relaxed text-ink-100" style="animation-delay: 160ms">
        {subtitle}
      </p>
    )}
  </div>
</section>
