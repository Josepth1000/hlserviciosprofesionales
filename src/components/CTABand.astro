---
import Icon from './Icon.astro';
import { getSiteData, getTextosData, getWhatsAppLink } from '../lib/content';

const site = await getSiteData();
const textos = await getTextosData();
const waLink = getWhatsAppLink(site.whatsapp, textos.global.whatsappMessage);
---

<section class="bg-gradient-to-r from-ink-900 to-ink-700" data-reveal>
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-6 px-4 py-14 text-center sm:px-6 lg:flex-row lg:justify-between lg:text-left lg:px-8">
    <div>
      <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">{textos.cta.title}</h2>
      <p class="mt-2 max-w-xl text-ink-100">{textos.cta.subtitle}</p>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href={waLink}
        target="_blank"
        rel="noopener"
        data-magnetic
        class="btn-shine inline-flex items-center gap-2 rounded-md bg-brand-500 px-5 py-3 text-sm font-semibold text-ink-950 transition hover:bg-brand-400"
      >
        <Icon name="whatsapp" class="h-5 w-5" />
        {textos.cta.whatsappLabel}
      </a>
      <a
        href="/contacto"
        data-magnetic
        class="inline-flex items-center gap-2 rounded-md border border-white/30 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
      >
        {textos.cta.contactLabel}
      </a>
    </div>
  </div>
</section>
