---
/**
 * Encabezado de sección con numeración editorial DENTRO del propio `h2`.
 *
 * Sustituye el patrón «etiqueta pequeña en mayúsculas encima del titular»
 * (anti-patrón `kicker-above-heading`, detectado por Impeccable en 5 secciones).
 * Al formar parte del encabezado, el rótulo deja de ser decoración suelta y
 * pasa a ser mobiliario editorial: número, filete y nombre de la sección.
 *
 * El número es posicional (orden de lectura de la página), no un campo del
 * panel: insertar una sección en medio renumera el render, nunca el contenido.
 */
interface Props {
  /** Posición de la sección en la página: 1 → «01». */
  number: number;
  /** Rótulo editable desde el panel (campo `label`). */
  label: string;
  /** Titular editable desde el panel (campo `title`). */
  title: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  id?: string;
  /** Escala del titular; por defecto, la de las secciones del sitio. */
  titleClass?: string;
  class?: string;
}

const {
  number,
  label,
  title,
  align = 'left',
  tone = 'light',
  id,
  titleClass = 'text-3xl sm:text-4xl',
  class: className,
} = Astro.props;

const mark = String(number).padStart(2, '0');
const centered = align === 'center';
const dark = tone === 'dark';
---

<h2
  id={id}
  class:list={[dark ? 'text-white' : 'text-ink-900', centered && 'text-center', className]}
>
  <span
    class:list={[
      'flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.18em]',
      centered && 'justify-center',
      dark ? 'text-brand-400' : 'text-brand-700',
    ]}
  >
    <span class="tabular-nums">{mark}</span>
    <span
      class:list={['h-px w-6 shrink-0', dark ? 'bg-brand-400/50' : 'bg-brand-500/60']}
      aria-hidden="true"></span>
    <span>{label}</span>
  </span>
  <span class:list={['mt-2.5 block font-display font-bold', titleClass]}>{title}</span>
</h2>
