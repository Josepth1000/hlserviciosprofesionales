---
/**
 * Encabezado de sección con numeración editorial dentro del propio `h2`.
 *
 * El rótulo pequeño en mayúsculas sobre el titular (anti-patrón
 * `kicker-above-heading`) ya no se pinta: queda solo el número, pegado al
 * titular como marca editorial. Los rótulos siguen en el panel (campo `label`)
 * para no perder el contenido, pero el render no los usa.
 *
 * El número es posicional (orden de lectura de la página), no un campo del
 * panel: insertar una sección en medio renumera el render, nunca el contenido.
 */
interface Props {
  /** Posición de la sección en la página: 1 → «01». */
  number: number;
  /** Titular editable desde el panel (campo `title`). */
  title: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  id?: string;
  /** Escala del titular; por defecto, la de las secciones del sitio. */
  titleClass?: string;
  class?: string;
}

const {
  number,
  title,
  align = 'left',
  tone = 'light',
  id,
  titleClass = 'text-3xl sm:text-4xl',
  class: className,
} = Astro.props;

const mark = String(number).padStart(2, '0');
const centered = align === 'center';
const dark = tone === 'dark';
---

<h2
  id={id}
  class:list={[dark ? 'text-white' : 'text-ink-900', centered && 'text-center', className]}
>
  <span class:list={['block font-display font-bold', titleClass]}>
    <span aria-hidden="true" class:list={['mr-[0.3em] tabular-nums', dark ? 'text-brand-400' : 'text-brand-700']}
      >{mark}.</span>{title}
  </span>
</h2>
