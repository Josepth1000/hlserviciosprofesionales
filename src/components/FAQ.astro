---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { getTextosData } from '../lib/content';
import type { FaqEntry } from '../lib/content';

interface Props {
  faqs: FaqEntry[];
}

const { faqs } = Astro.props;
const textos = await getTextosData();
---

{
  faqs.length > 0 && (
    <Fragment>
      <section id="preguntas-frecuentes" class="bg-ocre" data-reveal>
        <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
          <div class="text-center">
            <SectionHeading
              number={4}
              title={textos.home.faq.title}
              align="center"
            />
            <p class="mt-4 text-slate-600">{textos.home.faq.intro}</p>
          </div>

          <div class="mt-10 space-y-3">
            {faqs.map((faq) => {
              // Ancla estable: sale del nombre del archivo en el CMS, no del
              // índice, para que el enlace compartido no se rompa al reordenar.
              const anchor = `faq-${faq.id}`;
              const answerId = `faq-answer-${faq.id}`;
              return (
                <div
                  id={anchor}
                  class="faq-item group/item overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md"
                >
                  <div class="flex items-center gap-1 pr-3">
                    <button
                      type="button"
                      class="faq-toggle flex w-full items-center justify-between gap-4 py-4 pl-6 pr-2 text-left transition hover:bg-slate-50"
                      aria-expanded="false"
                      aria-controls={answerId}
                    >
                      <span class="font-semibold text-ink-900">{faq.data.question}</span>
                      <Icon name="chevron" class="faq-chevron h-5 w-5 shrink-0 text-brand-600" />
                    </button>
                    <button
                      type="button"
                      class="faq-copy"
                      data-faq-copy={anchor}
                      data-faq-label={`Copiar el enlace de la pregunta: ${faq.data.question}`}
                      aria-label={`Copiar el enlace de la pregunta: ${faq.data.question}`}
                      title="Copiar el enlace de esta pregunta"
                    >
                      <Icon name="link" class="faq-copy-icon h-4 w-4" />
                      <Icon name="check" class="faq-copy-check h-4 w-4" />
                    </button>
                  </div>
                  <div class="faq-answer" id={answerId} role="region">
                    <div class="border-t border-slate-100 px-6 pb-5 pt-4">
                      <p class="max-w-[54ch] text-sm leading-relaxed text-slate-600">{faq.data.answer}</p>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>

      {/* Fuera de la sección: su `will-change: transform` (revelado) convertiría
          el aviso fijo en un elemento posicionado respecto a la sección. */}
      <p class="faq-toast" role="status" aria-live="polite" id="faq-copy-status"></p>
    </Fragment>
  )
}
