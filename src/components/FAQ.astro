---
import Icon from './Icon.astro';
import { getTextosData } from '../lib/content';
import type { FaqEntry } from '../lib/content';

interface Props {
  faqs: FaqEntry[];
}

const { faqs } = Astro.props;
const textos = await getTextosData();
---

{
  faqs.length > 0 && (
    <section id="preguntas-frecuentes" class="bg-ocre" data-reveal>
      <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
        <div class="text-center">
          <p class="text-xs font-semibold uppercase tracking-widest text-brand-600">{textos.home.faq.label}</p>
          <h2 class="mt-3 font-display text-3xl font-bold text-ink-900 sm:text-4xl">
            {textos.home.faq.title}
          </h2>
          <p class="mt-4 text-slate-600">{textos.home.faq.intro}</p>
        </div>

        <div class="mt-10 space-y-3">
          {faqs.map((faq, i) => {
            const answerId = `faq-answer-${i}`;
            return (
              <div class="faq-item overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
                <button
                  type="button"
                  class="faq-toggle flex w-full items-center justify-between gap-4 px-6 py-4 text-left transition hover:bg-slate-50"
                  aria-expanded="false"
                  aria-controls={answerId}
                >
                  <span class="font-semibold text-ink-900">{faq.data.question}</span>
                  <Icon name="chevron" class="faq-chevron h-5 w-5 shrink-0 text-brand-600" />
                </button>
                <div class="faq-answer" id={answerId} role="region">
                  <div class="border-t border-slate-100 px-6 pb-5 pt-4">
                    <p class="text-sm leading-relaxed text-slate-600">{faq.data.answer}</p>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )
}
