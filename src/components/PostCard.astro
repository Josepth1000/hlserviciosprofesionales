---
import Icon from './Icon.astro';
import { getTextosData } from '../lib/content';
import { formatDate } from '../lib/format';

interface Props {
  title: string;
  excerpt: string;
  pubDate: Date;
  category: string;
  slug: string;
  delay?: number;
}

const { title, excerpt, pubDate, category, slug, delay = 0 } = Astro.props;
const textos = await getTextosData();
---

<article
  data-reveal
  data-spotlight
  style={`--reveal-delay: ${delay}ms`}
  class="group relative flex flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1.5 hover:border-brand-300/70 hover:shadow-xl"
>
  <div class="flex items-center gap-2 text-xs font-medium text-slate-500">
    <span class="rounded-full bg-brand-100 px-2.5 py-1 text-brand-700">{category}</span>
    <time datetime={pubDate.toISOString()} class="flex items-center gap-1">
      <Icon name="calendar" class="h-3.5 w-3.5" />
      {formatDate(pubDate)}
    </time>
  </div>
  <h3 class="mt-3 font-display text-lg font-semibold leading-snug text-ink-900 transition group-hover:text-ink-700">
    <a href={`/blog/${slug}`}>{title}</a>
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{excerpt}</p>
  <a
    href={`/blog/${slug}`}
    class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-ink-700 transition group-hover:gap-2.5 hover:text-brand-600"
  >
    {textos.blog.readMoreLabel}
    <Icon name="arrow" class="h-4 w-4" />
  </a>
</article>
