---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PaletteStyle from '../components/PaletteStyle.astro';
import Icon from '../components/Icon.astro';
import { ClientRouter } from 'astro:transitions';
import { getSiteData, getTextosData, getWhatsAppLink } from '../lib/content';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** `article` en las entradas del blog: cambia og:type y publica los datos del artículo. */
  ogType?: 'website' | 'article';
  article?: {
    publishedTime: Date;
    section?: string;
    tags?: string[];
  };
  /**
   * La 404 no es una página real: sin canónica ni og:url hacia una ruta que no
   * existe. Cualquier otra página debe declararlas.
   */
  noCanonical?: boolean;
}

const site = await getSiteData();
const textos = await getTextosData();
const {
  title,
  description = site.description,
  ogType = 'website',
  article,
  noCanonical = false,
} = Astro.props;
// Canónica sin barra final (salvo la raíz, que la lleva por obligación): es la
// forma de los enlaces internos y la que fija `trailingSlash: false` en
// vercel.json. Así cada página se anuncia con una sola URL.
const rutaCanonica = Astro.url.pathname.replace(/\/+$/, '');
const canonical = new URL(rutaCanonica || '/', Astro.site);
const waLink = getWhatsAppLink(site.whatsapp, textos.global.whatsappMessage);
const fonts = site.fonts ?? {};
const fontVars = [
  `--font-sans: '${fonts.body || 'Instrument Sans'}', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif`,
  `--font-display: '${fonts.display || 'Playfair Display'}', ui-serif, Georgia, serif`,
  `--font-script: '${fonts.script || 'Great Vibes'}', 'Segoe Script', cursive`,
].join('; ');
// Base de las URLs absolutas que consume la vista previa social y el JSON-LD.
// Mientras el dominio definitivo (astro.config.mjs → `site`) no apunte a este
// proyecto, PUBLIC_SITE_URL permite apuntarlas al despliegue que sí está
// sirviendo el sitio; al migrar el dominio basta con borrar la variable y todo
// vuelve a `site`. Las canónicas y el sitemap siguen usando el dominio final.
const basePublica = import.meta.env.PUBLIC_SITE_URL || Astro.site;
const absoluteUrl = (path?: string) => new URL(path || '/images/hero/image.jpg', basePublica).href;
// Imagen de vista previa social: lockup de marca 1200×630 (no una foto suelta,
// que además cambiaba de proporción al compartirse).
const ogImage = absoluteUrl('/og-image.jpg');
const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  slogan: site.slogan,
  description: site.description,
  url: new URL('/', Astro.site).href,
  logo: absoluteUrl(site.logo),
  image: ogImage,
  telephone: site.phone,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address,
    addressLocality: 'Bucaramanga',
    addressRegion: 'Santander',
    addressCountry: 'CO',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: textos.contact.map.lat,
    longitude: textos.contact.map.lng,
  },
  openingHours: site.hours,
  sameAs: (site.social ?? []).map((s) => s.url).filter(Boolean),
};
// Datos estructurados de la entrada del blog: sin ellos Google solo ve la ficha
// de la firma y no puede tratar la página como un artículo con fecha ni autor.
const articleSchema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: ogImage,
      datePublished: article.publishedTime.toISOString(),
      dateModified: article.publishedTime.toISOString(),
      inLanguage: 'es-CO',
      articleSection: article.section,
      keywords: article.tags?.length ? article.tags.join(', ') : undefined,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
      author: { '@type': 'Person', name: textos.about.founder.name },
      publisher: {
        '@type': 'Organization',
        name: site.name,
        logo: { '@type': 'ImageObject', url: absoluteUrl(site.logo) },
      },
    }
  : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B0B0D" />
    <!-- Marca el documento como «con JS» ANTES del primer pintado: así el menú
         móvil nace plegado (html.js #mobile-menu) y no empuja el contenido al
         cargar el script, que era la mayor fuente de CLS. Sin JS se mantiene el
         respaldo: el menú queda visible y accesible. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title} | {site.name}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon-48.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {!noCanonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={`${title} | ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_CO" />
    {!noCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={site.name} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime.toISOString()} />
          <meta property="article:author" content={site.name} />
          {article.section && <meta property="article:section" content={article.section} />}
          {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${site.name}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaOrg)} />
    {
      articleSchema && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
      )
    }

    <meta name="generator" content={Astro.generator} />

    <!-- Fuentes autoalojadas (ver @font-face en global.css): ya no hay hoja de
         estilos de terceros bloqueando el render. No se precargan a propósito:
         bajo el perfil móvil competirían por el ancho de banda con la imagen del
         hero, que es el elemento LCP, y retrasarían su pintado. -->
    <PaletteStyle />
    <!-- Navegación SPA con transiciones animadas (respecta prefers-reduced-motion) -->
    <ClientRouter />
  </head>
  <body
    class="flex min-h-screen flex-col font-sans antialiased"
    data-cursor-enabled={String(site.cursor?.enabled ?? true)}
    data-cursor-effect={site.cursor?.effect ?? 'halo'}
    style={`--cursor-size: ${site.cursor?.size ?? 360}px; ${fontVars}`}
  >
    <a href="#contenido" class="skip-link">{textos.global.skipLinkLabel}</a>
    <!-- Barra de progreso de lectura (arriba, bajo el header; gestionada en site.ts) -->
    <div id="scroll-progress" aria-hidden="true"></div>
    <Header />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Volver arriba (interacciones gestionadas en src/scripts/site.ts) -->
    <button id="back-to-top" type="button" aria-label={textos.global.backToTopLabel}>
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m4.5 15.75 7.5-7.5 7.5 7.5" />
      </svg>
    </button>

    <!-- WhatsApp flotante: acceso directo al chat desde cualquier página -->
    <a
      id="wa-fab"
      href={waLink}
      target="_blank"
      rel="noopener"
      aria-label={textos.nav.whatsappLabel}
    >
      <Icon name="whatsapp" class="h-7 w-7" />
    </a>
  </body>
</html>

<script>
  import '../scripts/site';
  import '../scripts/analytics';
  import '../scripts/icon-animations';
</script>
